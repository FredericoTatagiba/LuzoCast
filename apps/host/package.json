{
  "name": "@luzocast/host",
  "productName": "LuzoCast",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "LuzoCast — app desktop do host",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "pnpm --filter @luzocast/viewer build && electron-vite dev",
    "build": "electron-vite build",
    "dist": "pnpm --filter @luzocast/viewer build && electron-vite build && node scripts/fetch-cloudflared.mjs --if-missing && electron-builder --win --x64",
    "typecheck": "tsc -p tsconfig.node.json && vue-tsc -p tsconfig.web.json",
    "fetch:cloudflared": "node scripts/fetch-cloudflared.mjs"
  },
  "devDependencies": {
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@luzocast/core": "workspace:*",
    "@luzocast/security": "workspace:*",
    "@luzocast/server": "workspace:*",
    "@luzocast/signaling": "workspace:*",
    "@luzocast/transport": "workspace:*",
    "@luzocast/tunnel": "workspace:*",
    "@luzocast/ui": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.0",
    "fastify": "^5.2.0",
    "vite": "^6.0.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "author": "Frederico Tatagiba",
  "homepage": "https://github.com/FredericoTatagiba/luzocast"
}
